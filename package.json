{
  "name": "lifeops-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "dev:server": "tsx server/index.ts",
    "test": "tsx --test server/tests/agentCore.test.ts server/tests/providerArchitecture.test.ts server/tests/comparisonEngine.test.ts server/tests/verificationEngine.test.ts server/tests/executionPreparation.test.ts server/tests/sandboxExecution.test.ts server/tests/endToEndAgent.test.ts server/tests/personalization.test.ts server/tests/preferenceConflict.test.ts server/tests/adaptiveLearning.test.ts server/tests/voiceInteraction.test.ts server/tests/infrastructure.test.ts server/tests/clerkAuth.test.ts server/tests/webShoppingAgent.test.ts",
    "dev:all": "concurrently -k -n \"API,WEB\" -c \"magenta,cyan\" \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/themes": "^2.4.57",
    "@supabase/supabase-js": "^2.115.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.2.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
